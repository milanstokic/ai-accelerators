{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FDE workflow",
  "type": "object",
  "required": ["phases"],
  "properties": {
    "name": { "type": "string", "description": "Workflow name shown in the Progress view." },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "description": "Stable identifier for the phase." },
          "title": { "type": "string" },
          "skills": { "type": "array", "items": { "type": "string" }, "description": "Skill or command names relevant in this phase." },
          "checklist": { "type": "array", "items": { "type": "string" }, "description": "Items to tick off before moving on." }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
