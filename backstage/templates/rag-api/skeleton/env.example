# RAG API Environment Configuration
# Copy this file to .env and fill in the values

# LLM Configuration
RAG_LLM_PROVIDER=${{ values.llmProvider }}
RAG_LLM_API_KEY=your-api-key-here

# Embedding Configuration  
RAG_EMBEDDING_PROVIDER=${{ values.embeddingProvider }}
RAG_EMBEDDING_API_KEY=your-api-key-here
RAG_EMBEDDING_MODEL=${{ values.embeddingModel }}

# Vector Store Configuration
RAG_COLLECTION_NAME=${{ values.collectionName }}

# Application Settings
RAG_DEBUG=false
RAG_LOG_LEVEL=INFO
